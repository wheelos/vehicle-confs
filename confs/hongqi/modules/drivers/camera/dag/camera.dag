    #================ wide Camera (2.3mm) ================
    # components {
    #     class_name : "CameraComponent"
    #     config {
    #         name : "wide"
    #         config_file_path : "/apollo/modules/drivers/camera/conf/wide.pb.txt"
    #     }
    # }

    #================ Obstacle Camera (6mm) ================
    components {
        class_name : "CameraComponent"
        config {
            name : "obstacle"
            config_file_path : "/apollo/modules/drivers/camera/conf/obstacle.pb.txt"
        }
    }

    #================ Traffic Camera (25mm) ================
    # components {
    #     class_name : "CameraComponent"
    #     config {
    #         name : "traffic"
    #         config_file_path : "/apollo/modules/drivers/camera/conf/traffic.pb.txt"
    #     }
    # }

    #================ RightForward Camera (2.3mm) ================
    components {
        class_name : "CameraComponent"
        config {
            name : "rightforward"
            config_file_path : "/apollo/modules/drivers/camera/conf/rightforward.pb.txt"
        }
    }

    #================ RightBackward Camera (4.1mm) ================
    components {
        class_name : "CameraComponent"
        config {
            name : "rightbackward"
            config_file_path : "/apollo/modules/drivers/camera/conf/rightbackward.pb.txt"
        }
    }

    #================ Backward Camera (6mm) ================
    components {
        class_name : "CameraComponent"
        config {
            name : "backward"
            config_file_path : "/apollo/modules/drivers/camera/conf/backward.pb.txt"
        }
    }

    #================ LeftBackward Camera (4.1mm) ================
    components {
        class_name : "CameraComponent"
        config {
            name : "leftbackward"
            config_file_path : "/apollo/modules/drivers/camera/conf/leftbackward.pb.txt"
        }
    }

    #================ LeftForward Camera (2.3mm) ================
    components {
        class_name : "CameraComponent"
        config {
            name : "leftforward"
            config_file_path : "/apollo/modules/drivers/camera/conf/leftforward.pb.txt"
        }
    }
}
